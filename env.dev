# Variáveis de ambiente de DESENVOLVIMENTO (usadas pelo docker-compose).
# Não use estes valores em produção.
DEBUG=1
SECRET_KEY=dev-secret-key-trocar-em-producao
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1] 0.0.0.0
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=bookstore_dev_db
SQL_USER=bookstore_dev
SQL_PASSWORD=bookstore_dev
SQL_HOST=db
SQL_PORT=5432
